#include<stdio.h>
int main()
{
    int x[10][10];
    for(int i=0;i<2;i++)
    {
        for(int j=0;j<2;j++)
        {
            printf("enter the data[%d] [%d]:",i,j);
            scanf("%d",&x[i][j]);
        }
    }
    for(int i=0;i<2;i++)
    {
        for(int j=0;j<2;j++)
        {
            printf("%d\t",x[i][j]);
        }
        printf("\n");
    }
    return 0;
}
