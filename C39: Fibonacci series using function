#include<stdio.h>
int fibo(int fa)
{
    int a=0,b=1,c;
    printf("Fibonacci series \n");
    for(int i=0;i<=fa;i++)
    {
        printf("%d\n",a);
        c=a+b;
        a=b;
        b=c;
    }
}
int main()
{
    int f;
    printf("enter the value");
    scanf("%d",&f);
    fibo(f);
    return 0;
    
}
